# =============================================================================
# Конфигурация подключения к БД для приложения GestureBind.
# Скопируйте этот файл в `.env` и при необходимости переопределите значения.
# Файл `.env` подгружается автоматически в app/models/database.py.
# =============================================================================

# Полный SQLAlchemy URL (имеет наивысший приоритет, если задан).
# DATABASE_URL=postgresql+psycopg2://dplm:dplm@localhost:5432/dplm

# MVP по умолчанию работает локально на SQLite без Docker.
DPLM_DB_BACKEND=sqlite
DPLM_SQLITE_PATH=~/.dplm/dplm.sqlite

# Параметры PostgreSQL используются только при DPLM_DB_BACKEND=postgres.
DPLM_DB_HOST=localhost
DPLM_DB_PORT=5433
DPLM_DB_USER=dplm
DPLM_DB_PASSWORD=dplm
DPLM_DB_NAME=dplm

# Агент привязок: по умолчанию используется локальный deterministic-пайплайн.
# Если MISTRAL_API_KEY задан, агент попробует Mistral автоматически.
# DPLM_BINDING_AGENT_PROVIDER=mistral
# DPLM_BINDING_AGENT_PROVIDER=local
# MISTRAL_API_KEY=your_mistral_api_key_here
# MISTRAL_MODEL=mistral-small-latest
# MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
# DPLM_BINDING_AGENT_LOCAL_FIRST=1
# DPLM_BINDING_AGENT_REWRITE_ANSWERS=0
# DPLM_BINDING_AGENT_TIMEOUT_SECONDS=12
# DPLM_BINDING_RESEARCH_WEB=0

# MLflow-трассировка пайплайна агента привязок.
# По умолчанию включена и пишет в sqlite:///mlflow.db в корне проекта.
# DPLM_BINDING_AGENT_MLFLOW=1
# DPLM_BINDING_AGENT_GENAI_TRACES=1
# DPLM_BINDING_AGENT_GENAI_EVAL=1
# DPLM_BINDING_AGENT_MLFLOW_EXPERIMENT=GestureBind
# MLFLOW_TRACKING_URI=sqlite:///mlflow.db
# MLflow асинхронен по умолчанию; sync полезен только для тестов/диагностики.
# DPLM_BINDING_AGENT_MLFLOW_SYNC=0

# Анонимная эксплуатационная статистика. Пользователь всё равно должен
# включить отправку в приложении; endpoint сам по себе не включает telemetry.
# DPLM_TELEMETRY_ENABLED=0
# DPLM_TELEMETRY_ENDPOINT=https://telemetry.example.com/v1/telemetry/daily
# DPLM_TELEMETRY_PROJECT_KEY=public-project-key
# DPLM_TELEMETRY_INTERVAL_HOURS=24

# Независимый Mistral judge для scripts/evaluate_binding_agent_mas.py.
# GESTUREBIND_JUDGE_MODEL=mistral-small-latest
# GESTUREBIND_JUDGE_TIMEOUT=12
